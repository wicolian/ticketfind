{
  "name": "ticketfind",
  "version": "0.1.0",
  "description": "Get pinged the second seats open, even when the booking site is melting down. Movies, events, buses, trains.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ticketfind": "dist/server/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web \"tsx watch src/server/cli.ts --no-open\" \"vite --config web/vite.config.ts\"",
    "build": "pnpm build:web && pnpm build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/server/cli.js",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:web && pnpm typecheck:api",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck:api": "tsc -p tsconfig.api.json"
  },
  "keywords": [
    "tickets",
    "seat-alert",
    "bookmyshow",
    "pvr",
    "inox",
    "district",
    "notifications",
    "ntfy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wicolian/ticketfind"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "open": "^11.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
