# ticketfind needs none of these to run. Copy what you need into a file named .env.local
# (any .env file is ignored by git, so keys never get committed).

# ---- The app on your computer (npx ticketfind) ----
PORT=4848                      # where the app listens (127.0.0.1 only)
TICKETFIND_HOME=               # where watches and settings live; default ~/.ticketfind

# Plain-words setup (optional). Either key works; you can also paste it under Alerts in the app.
OPENROUTER_API_KEY=            # sk-or-... uses Claude Haiku 5.5 through OpenRouter
ANTHROPIC_API_KEY=             # sk-ant-... calls Claude directly
TICKETFIND_OPENROUTER_MODEL=   # default anthropic/claude-haiku-5.5

# Jev reads concert and event pages and says when tickets go on sale (optional). TypeSafe key.
TYPESAFE_API_KEY=              # apikey_...
TICKETFIND_JEV_MODEL=          # default jev-latest

# ---- The public website (Vercel) ----
# Nothing is required: Explore and live seats use public cinema data only.
#
# Optional: plain words on the website ("2 seats before 7 pm, not the front rows").
# Use a SEPARATE OpenRouter key with a credit limit set on openrouter.ai (Keys > Edit > Credit limit),
# so even a bug can never spend more than that. Never put an Anthropic key here.
OPENROUTER_API_KEY=            # website-only key, with a credit limit
TICKETFIND_AI_PER_IP_HOUR=10   # requests per visitor per hour
TICKETFIND_AI_PER_DAY=300      # requests for the whole site per day
# Optional: share the limits across all of Vercel's servers (free Upstash Redis). Without these,
# each server counts on its own, which is weaker but still limited.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
